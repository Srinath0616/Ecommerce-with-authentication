<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
</head>
<%- include('./partials/header') %>

<% if(error.length>0){ %>
<div class="fixed top-5 left-1/2 -translate-x-1/2 z-50 p-3 rounded-md bg-red-500 w-[90%] max-w-md text-center">
    <span class="inline-block text-white">
        <%= error %>
    </span>
</div>
<% } %>

<div class="w-full min-h-screen flex flex-col lg:flex-row px-5 md:px-10 lg:px-20 py-10">

    <div class="w-full lg:w-1/2 flex items-center justify-center">
        <div class="w-full max-w-md lg:max-w-lg lg:px-10">
            <h3 class="text-3xl md:text-4xl">
                welcome to <span class="text-blue-400 font-semibold">Scatch</span>
            </h3>

            <h4 class="text-xl md:text-2xl mb-5">
                create your account
            </h4>

            <form autocomplete="off" action="/users/register" method="post">

                <input
                    class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-3 border-zinc-200"
                    type="text"
                    placeholder="Full Name"
                    name="fullname">

                <input
                    class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-3 border-zinc-200"
                    type="email"
                    placeholder="Email"
                    name="email">

                <input
                    class="bg-zinc-100 block w-full px-3 py-3 border rounded-md mb-4 border-zinc-200"
                    type="password"
                    placeholder="Password"
                    name="password">

                <input
                    class="w-full sm:w-auto px-6 rounded-full py-3 bg-blue-500 text-white cursor-pointer"
                    type="submit"
                    value="Create My Account">

            </form>
        </div>
    </div>

    <div class="w-full lg:w-1/2 flex items-center justify-center mt-12 lg:mt-0">
        <div class="w-full max-w-md lg:max-w-lg lg:px-10">

            <h4 class="text-xl md:text-2xl capitalize mb-5">
                login your account
            </h4>

            <form autocomplete="off" action="/users/login" method="post">

                <input
                    class="block bg-zinc-100 w-full px-3 py-3 border rounded-md mb-3 border-zinc-200"
                    type="email"
                    placeholder="Email"
                    name="email">

                <input
                    class="block bg-zinc-100 w-full px-3 py-3 border rounded-md mb-4 border-zinc-200"
                    type="password"
                    placeholder="Password"
                    name="password">

                <input
                    class="w-full sm:w-auto px-6 rounded-full py-3 bg-blue-500 text-white cursor-pointer"
                    type="submit"
                    value="Login">

            </form>
        </div>
    </div>

</div>

<%- include('./partials/footer') %>