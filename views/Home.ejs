<%- include('./partials/header') %>

<div class="min-h-screen bg-gradient-to-br from-gray-100 via-white to-gray-200">

    <section class="max-w-7xl mx-auto px-10 py-20">

        <div class="flex items-center justify-between">

            <!-- Left -->
            <div class="max-w-2xl">

                <span class="inline-block px-4 py-2 rounded-full bg-black text-white text-sm mb-6">
                    ✨ New Arrivals Available
                </span>

                <h1 class="text-6xl font-extrabold leading-tight text-gray-900">
                    Carry Style.
                    <br>
                    Carry
                    <span class="text-gray-500">Scatch.</span>
                </h1>

                <p class="mt-8 text-lg text-gray-600 leading-8">
                    Discover premium backpacks, duffle bags, office bags and travel
                    essentials designed with elegance and durability.
                </p>

                <div class="flex gap-5 mt-10">

                    <a href="/shop"
                        class="px-8 py-4 rounded-xl bg-black text-white font-semibold hover:bg-gray-800 transition">
                        Shop Now
                    </a>

                    <a href="/cart"
                        class="px-8 py-4 rounded-xl border-2 border-black font-semibold hover:bg-black hover:text-white transition">
                        View Cart
                    </a>

                </div>

            </div>
            <div class="relative">

                <div
                    class="w-[420px] h-[420px] rounded-full bg-gradient-to-br from-gray-900 via-gray-700 to-gray-500 shadow-2xl flex items-center justify-center">

                    <i class="ri-shopping-bag-4-fill text-white text-[180px]"></i>

                </div>

            </div>

        </div>

    </section>

    <section class="max-w-7xl mx-auto px-10 pb-20">

        <div class="grid grid-cols-3 gap-8">

            <div class="bg-white rounded-2xl shadow-md p-8">

                <i class="ri-truck-line text-4xl"></i>

                <h2 class="text-2xl font-bold mt-5">
                    Free Shipping
                </h2>

                <p class="mt-3 text-gray-600">
                    Fast and secure delivery on every order.
                </p>

            </div>

            <div class="bg-white rounded-2xl shadow-md p-8">

                <i class="ri-shield-check-line text-4xl"></i>

                <h2 class="text-2xl font-bold mt-5">
                    Secure Payments
                </h2>

                <p class="mt-3 text-gray-600">
                    Your payments are protected with industry standards.
                </p>

            </div>

            <div class="bg-white rounded-2xl shadow-md p-8">

                <i class="ri-refresh-line text-4xl"></i>

                <h2 class="text-2xl font-bold mt-5">
                    Easy Returns
                </h2>

                <p class="mt-3 text-gray-600">
                    Hassle-free returns within 7 days.
                </p>

            </div>

        </div>

    </section>

    <section class="bg-black text-white py-20">

        <div class="max-w-5xl mx-auto text-center">

            <h2 class="text-5xl font-bold">
                Find Your Perfect Bag Today.
            </h2>

            <p class="mt-6 text-gray-300 text-lg">
                Explore our curated collection crafted for work, travel and everyday life.
            </p>

            <a href="/shop"
                class="inline-block mt-10 px-10 py-4 bg-white text-black rounded-xl font-semibold hover:bg-gray-200 transition">
                Explore Collection
            </a>

        </div>

    </section>

</div>

<%- include('./partials/footer') %>