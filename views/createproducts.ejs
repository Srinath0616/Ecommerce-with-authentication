<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Page</title>
</head>

<%- include('./partials/header') %>

<% if(success.length>0){ %>
<div class="fixed top-5 left-1/2 -translate-x-1/2 z-50 p-3 rounded-md bg-green-500 w-[90%] max-w-md text-center">
    <span class="inline-block text-white">
        <%= success %>
    </span>
</div>
<% } %>

<div class="min-h-screen flex flex-col">
    <div class="container mx-auto px-5 md:px-10 py-10 flex flex-col lg:flex-row gap-10">

        <div class="w-full lg:w-1/4">
            <div class="flex flex-row lg:flex-col gap-4 lg:gap-2">
                <a class="block w-fit hover:text-blue-500" href="">All Products</a>
                <a class="block w-fit hover:text-blue-500" href="">Create new product</a>
            </div>
        </div>

        <main class="w-full lg:w-3/4 bg-white p-5 md:p-8 shadow rounded-lg">

            <h2 class="text-2xl font-bold mb-6">
                Create New Product
            </h2>

            <form autocomplete="off" action="/products/create" method="post" enctype="multipart/form-data">

                <div class="mb-8">

                    <h3 class="text-lg font-semibold mb-4">
                        Product Details
                    </h3>

                    <div class="mb-5">
                        <label class="block mb-2 font-medium">
                            Product Image
                        </label>

                        <input
                            name="image"
                            type="file"
                            class="w-full border rounded p-2">
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <input
                            name="name"
                            type="text"
                            placeholder="Product Name"
                            class="border p-3 rounded w-full">

                        <input
                            name="price"
                            type="text"
                            placeholder="Product Price"
                            class="border p-3 rounded w-full">

                        <input
                            name="discount"
                            type="text"
                            placeholder="Discount Price"
                            class="border p-3 rounded w-full">

                    </div>

                </div>

                <div class="mb-8">

                    <h3 class="text-lg font-semibold mb-4">
                        Panel Details
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                        <input
                            name="bgcolor"
                            type="text"
                            placeholder="Background Color"
                            class="border p-3 rounded w-full">

                        <input
                            name="panelcolor"
                            type="text"
                            placeholder="Panel Color"
                            class="border p-3 rounded w-full">

                        <input
                            name="textcolor"
                            type="text"
                            placeholder="Text Color"
                            class="border p-3 rounded w-full">

                    </div>

                </div>

                <input
                    class="w-full md:w-auto px-6 py-3 rounded bg-blue-500 text-white cursor-pointer hover:bg-blue-600"
                    type="submit"
                    value="Create New Product">

            </form>

        </main>

    </div>
</div>

<%- include('./partials/footer') %>