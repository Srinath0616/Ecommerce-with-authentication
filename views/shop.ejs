<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop </title>
</head>

<%- include('./partials/header') %>

<% if(success.length > 0){ %>
<div
    class="fixed top-5 left-1/2 -translate-x-1/2 bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg z-50">
    <%= success %>
</div>
<% } %>

<div class="min-h-screen bg-gray-100 px-12 py-10 flex gap-10">

    <aside class="w-64 bg-white rounded-2xl shadow-md p-6 h-fit">

        <h2 class="text-2xl font-bold mb-8">
            Filters
        </h2>

        <div class="mb-8">
            <h3 class="font-semibold mb-3">Sort By</h3>

            <form action="/shop">
                <select
                    class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-black outline-none"
                    name="sortby">

                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>

                </select>
            </form>
        </div>

        <div class="mb-8">

            <h3 class="font-semibold mb-3">
                Collections
            </h3>

            <div class="flex flex-col gap-2 text-gray-600">

                <a href="#" class="hover:text-black transition">
                    New Collection
                </a>

                <a href="#" class="hover:text-black transition">
                    All Products
                </a>

                <a href="#" class="hover:text-black transition">
                    Discounted Products
                </a>

            </div>

        </div>

        <div>

            <h3 class="font-semibold mb-3">
                Filter
            </h3>

            <div class="flex flex-col gap-2 text-gray-600">

                <a href="#" class="hover:text-black transition">
                    Availability
                </a>

                <a href="#" class="hover:text-black transition">
                    Discount
                </a>

            </div>

        </div>

    </aside>

    <section class="flex-1">

        <div class="flex justify-between items-center mb-8">

            <h1 class="text-4xl font-bold">
                Explore Bags
            </h1>

            <p class="text-gray-500">
                <%= products.length %> Products
            </p>

        </div>

        <div class="grid grid-cols-4 gap-8">

            <% products.forEach(function(product){ %>

            <div
                class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl hover:-translate-y-1 transition duration-300">

                <div
                    class="w-full h-60 flex items-center justify-center p-6 <%= product.bgcolor %>">

                    <img
                        class="h-44 object-contain transition duration-300 hover:scale-110"
                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                        alt="">

                </div>

                <div
                    class="px-5 py-4 flex justify-between items-center <%= product.panelcolor %> <%= product.textcolor %>">

                    <div>

                        <h3 class="font-semibold text-lg">
                            <%= product.name %>
                        </h3>

                        <p class="text-2xl font-bold mt-1">
                            ₹ <%= product.price %>
                        </p>

                    </div>

                    <a
                        href="/addtocart/<%= product._id %>"
                        class="w-11 h-11 rounded-full bg-white text-black flex items-center justify-center shadow-md hover:scale-110 transition">

                        <i class="ri-add-line text-xl"></i>

                    </a>

                </div>

            </div>

            <% }) %>

        </div>

    </section>

</div>

<%- include('./partials/footer') %>