<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-['helvetica_now_display']">
    <nav class="relative w-full flex items-center justify-between px-5 py-4 border-b bg-white">

    <a href="/Home" class="text-2xl font-bold">
        Scatch
    </a>

    <% var loggedIn = typeof loggedIn !== "undefined" ? loggedIn : true; %>

    <% if(loggedIn){ %>

    <div class="hidden md:flex items-center gap-6">
        <a href="/shop">Shop</a>
        <a href="/cart">Cart</a>
        <a href="/profile">My Account</a>
        <a href="/users/logout" class="text-red-600">Logout</a>
    </div>

    <button id="menuBtn" class="md:hidden text-3xl p-2">
    <i class="ri-more-2-fill"></i>
</button>

    <div
    id="mobileMenu"
    class="hidden absolute top-12 right-4 w-40 bg-white rounded-lg shadow-lg border z-50">

    <a href="/shop" class="block px-4 py-3 hover:bg-gray-100">
        Shop
    </a>

    <a href="/cart" class="block px-4 py-3 hover:bg-gray-100">
        Cart
    </a>

    <a href="/profile" class="block px-4 py-3 hover:bg-gray-100">
        My Account
    </a>

    <a href="/users/logout" class="block px-4 py-3 text-red-600 hover:bg-gray-100">
        Logout
    </a>

</div>

    <% } %>

</nav>

<script>
const menuBtn = document.getElementById("menuBtn");
const mobileMenu = document.getElementById("mobileMenu");

if (menuBtn) {
    menuBtn.addEventListener("click", () => {
         mobileMenu.classList.toggle("hidden");
    });
}
</script>